  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccccqiang/dsh-relay-direct.git"
  },
  "homepage": "https://github.com/ccccqiang/dsh-relay-direct#readme",
  "bugs": {
    "url": "https://github.com/ccccqiang/dsh-relay-direct/issues"
  },
  "keywords": [
    "dsh",
    "dsh-bundle",
    "deepseek-harness",
    "proxy",
    "no_proxy",
    "relay"
  ],
  "files": [
    "cordis.patch.yml",
    "lib/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
